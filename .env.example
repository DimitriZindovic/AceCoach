# Copy this file to `.env` and fill in every value. `.env` is git-ignored.
# The build fails if `.env` is missing because it is bundled as an asset.

# --- OpenWeatherMap (https://home.openweathermap.org/api_keys) ---
OPENWEATHER_API_KEY=your_openweathermap_key

# --- Gemini through Firebase AI Logic ---
# Model name used by the AI service. Any Gemini model that supports JSON mode.
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase project (Firebase console > Project settings > Your apps) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Android app
FIREBASE_ANDROID_API_KEY=AIza...
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000

# iOS app
FIREBASE_IOS_API_KEY=AIza...
FIREBASE_IOS_APP_ID=1:000000000000:ios:0000000000000000
FIREBASE_IOS_BUNDLE_ID=com.acecoach.aceCoach

# --- Google Sign-In (Google Cloud console > Credentials) ---
# Web client id of the Firebase project: required on Android to get an idToken.
GOOGLE_SERVER_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
# iOS OAuth client id (also set as GIDClientID in ios/Runner/Info.plist).
GOOGLE_IOS_CLIENT_ID=000000000000-yyyy.apps.googleusercontent.com
